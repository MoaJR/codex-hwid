generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  PATIENT
  DOCTOR
  SECRETARY
  ADMIN
}
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}
enum ArticleBlockType {
  PARAGRAPH
  HEADING
  LIST
}
enum AppointmentMode {
  IN_PERSON
  ONLINE
}
enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
enum AvailabilityExceptionKind {
  AVAILABLE
  BLOCKED
}
enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  emailVerified Boolean @default(false)
  image String?
  twoFactorEnabled Boolean @default(false)
  sessions Session[]
  accounts Account[]
  twoFactors TwoFactor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRole[]
  patient Patient?
  doctor Doctor?
  auditEventsAsActor AuditEvent[] @relation("AuditEventActor")
  auditEventsAsSubject AuditEvent[] @relation("AuditEventSubject")
  articlesCreated Article[] @relation("ArticleCreatedBy")
  articlesUpdated Article[] @relation("ArticleUpdatedBy")
  articlesReviewed Article[] @relation("ArticleReviewedBy")
  articlesPublished Article[] @relation("ArticlePublishedBy")
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated Appointment[] @relation("AppointmentUpdatedBy")
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledBy")
  appointmentEvents AppointmentEvent[] @relation("AppointmentEventActor")
}
model UserRole {
  userId String @db.Uuid
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([userId, role])
}
model Patient {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  careAssignments CareAssignment[]
  moodEntries MoodEntry[]
  appointments Appointment[]
  createdAt DateTime @default(now())
}
model Doctor {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  careAssignments CareAssignment[]
  timeZone String @default("America/Sao_Paulo")
  appointmentServices AppointmentService[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments Appointment[]
}
model CareAssignment {
  patientId String @db.Uuid
  doctorId String @db.Uuid
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  endedAt DateTime?
  @@id([patientId, doctorId])
  @@index([doctorId, endedAt])
}
model MoodEntry {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  score Int
  recordedAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([patientId, recordedAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  mfaVerifiedAt DateTime? // App-owned marker, set only after successful server-side TOTP verification.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
  // This uniqueness matches one account per provider identity; confirm generated schema.
  @@unique([providerId, accountId])
}
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  @@index([secret])
  @@index([userId])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  action        String
  outcome       String
  source        String
  actorUserId   String?  @db.Uuid
  subjectUserId String?  @db.Uuid
  resourceType  String?
  resourceId    String?  @db.Uuid
  occurredAt    DateTime @default(now())
  actor         User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject       User?    @relation("AuditEventSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model Article {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  title            String
  excerpt          String
  category         String
  readingMinutes   Int
  status           ArticleStatus @default(DRAFT)
  editorialLabel   String
  reviewNotice     String
  publishedAt      DateTime?
  version          Int           @default(1)
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid
  reviewedById     String?       @db.Uuid
  publishedById    String?       @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        User?         @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?         @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy       User?         @relation("ArticleReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedBy      User?         @relation("ArticlePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  blocks           ArticleBlock[]

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
}

model ArticleBlock {
  id        String           @id @default(uuid()) @db.Uuid
  articleId String           @db.Uuid
  position  Int
  type      ArticleBlockType
  text      String?
  items     String[]         @default([])
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([articleId])
}

model AppointmentService {
  id                  String           @id @default(uuid()) @db.Uuid
  doctorId            String           @db.Uuid
  code                String
  name                String
  mode                AppointmentMode
  durationMinutes     Int
  slotIntervalMinutes Int              @default(30)
  bufferBeforeMinutes Int              @default(0)
  bufferAfterMinutes  Int              @default(0)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  doctor              Doctor           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointments        Appointment[]

  @@unique([doctorId, code])
  @@unique([id, doctorId])
  @@index([doctorId, active])
}

model AvailabilityRule {
  id          String    @id @default(uuid()) @db.Uuid
  doctorId    String    @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  validFrom   DateTime  @db.Date
  validUntil  DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, weekday, active])
  @@index([doctorId, validFrom, validUntil])
}

model AvailabilityException {
  id        String                    @id @default(uuid()) @db.Uuid
  doctorId  String                    @db.Uuid
  kind      AvailabilityExceptionKind
  startsAt  DateTime                  @db.Timestamptz(3)
  endsAt    DateTime                  @db.Timestamptz(3)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  doctor    Doctor                    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, startsAt])
}

model Appointment {
  id                  String             @id @default(uuid()) @db.Uuid
  doctorId            String             @db.Uuid
  patientId           String             @db.Uuid
  serviceId           String             @db.Uuid
  idempotencyKey      String             @unique @db.Uuid
  serviceLabel        String
  mode                AppointmentMode
  status              AppointmentStatus  @default(CONFIRMED)
  startsAt            DateTime           @db.Timestamptz(3)
  endsAt              DateTime           @db.Timestamptz(3)
  durationMinutes     Int
  bufferBeforeMinutes Int
  bufferAfterMinutes  Int
  blockedFrom         DateTime           @db.Timestamptz(3)
  blockedUntil        DateTime           @db.Timestamptz(3)
  timeZone            String
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String?            @db.Uuid
  cancelledByUserId   String?            @db.Uuid
  cancelledAt         DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  doctor              Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service             AppointmentService @relation(fields: [serviceId, doctorId], references: [id, doctorId], onDelete: Restrict)
  createdBy           User               @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User?              @relation("AppointmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  cancelledBy         User?              @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  events              AppointmentEvent[]

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

model AppointmentEvent {
  id               String                @id @default(uuid()) @db.Uuid
  appointmentId    String                @db.Uuid
  type             AppointmentEventType
  actorUserId      String?               @db.Uuid
  previousStartsAt DateTime?              @db.Timestamptz(3)
  previousEndsAt   DateTime?              @db.Timestamptz(3)
  nextStartsAt     DateTime?              @db.Timestamptz(3)
  nextEndsAt       DateTime?              @db.Timestamptz(3)
  previousStatus   AppointmentStatus?
  nextStatus       AppointmentStatus?
  occurredAt       DateTime               @default(now())
  appointment      Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actor            User?                  @relation("AppointmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model ApiRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
