# Copiar para .env.local; usar somente o PostgreSQL local de compose.dev.yml.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/douglas_vaz_dev?schema=public"

# Mantenha false para trabalhar só no site público; use true após preparar o banco local.
AUTH_ENABLED=false
BETTER_AUTH_URL="http://localhost:3000"
# Gere uma chave local aleatória com pelo menos 32 caracteres; nunca reutilize a chave de Produção.
BETTER_AUTH_SECRET=""
