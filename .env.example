# Copiar para .env.local; nunca usar dados reais no desenvolvimento.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/douglas_vaz_dev?schema=public"

# Auth stays disabled until schema, account provisioning and end-to-end checks pass.
AUTH_ENABLED=false
BETTER_AUTH_URL="http://localhost:3000"
# Use a random secret of at least 32 characters in the hosting secret store.
BETTER_AUTH_SECRET=""
